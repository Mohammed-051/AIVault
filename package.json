{
  "name": "aivault",
  "version": "1.3.1",
  "description": "A lockfile and permissions for agent skills: pins what you approved, holds updates that add network, secret or publish access, and routes agents to the 1-3 skills a task needs. Zero dependencies.",
  "type": "module",
  "bin": {
    "vault": "engine/cli.mjs",
    "vault-mcp": "engine/mcp.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "agent-skills",
    "skills",
    "mcp",
    "mcp-server",
    "skill-manager",
    "router",
    "security-scanner",
    "lockfile",
    "supply-chain-security",
    "permissions",
    "prompt-injection",
    "ai-agents",
    "cursor",
    "copilot"
  ],
  "scripts": {
    "test": "node tests/run.mjs",
    "setup": "node engine/cli.mjs setup"
  },
  "files": [
    "engine",
    "packs",
    "assets/banner.svg",
    "vault",
    "vault.cmd",
    "setup.cmd",
    "setup.sh",
    "README.md",
    "LICENSE"
  ]
}
